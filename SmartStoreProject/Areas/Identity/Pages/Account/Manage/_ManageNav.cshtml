@inject SignInManager<IdentityUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}
<style>
    .nav-link:focus, .nav-link:hover{
        color:white !important;
    }
  
</style>
<div>
    <ul class="nav nav-pills flex-column p-3" style="background-color:whitesmoke !important">
        <li class="nav-item"><a class="nav-link navDefault @ManageNavPages.IndexNavClass(ViewContext)" style=" color:black !important;" id="profile" asp-page="./Index">Profile</a></li>
        <li class="nav-item"><a class="nav-link navDefault @ManageNavPages.EmailNavClass(ViewContext)" style=" color:black !important" id="email" asp-page="./Email">Email</a></li>
        <li class="nav-item"><a class="nav-link navDefault @ManageNavPages.ChangePasswordNavClass(ViewContext)" style=" color:black !important" id="change-password" asp-page="./ChangePassword">Password</a></li>
        @if (hasExternalLogins)
        {
            <li id="external-logins" class="nav-item"><a id="external-login"  class="nav-link @ManageNavPages.ExternalLoginsNavClass(ViewContext)" asp-page="./ExternalLogins">External logins</a></li>
        }
        <li class="nav-item"><a class="nav-link navDefault @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" id="two-factor" style=" color:black !important" asp-page="./TwoFactorAuthentication">Two-factor authentication</a></li>
        <li class="nav-item"><a class="nav-link navDefault @ManageNavPages.PersonalDataNavClass(ViewContext)" id="personal-data" style=" color:black !important" asp-page="./PersonalData">Personal data</a></li>
    </ul>
</div>


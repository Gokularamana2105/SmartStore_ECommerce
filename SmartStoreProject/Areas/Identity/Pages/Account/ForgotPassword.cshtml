@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<style>
    input {
        height: 45px !important;
    }

    label {
        padding: 10px 10px !important;
    }
</style>
<div class="container mt-4 d-flex justify-content-center align-items-center">
    <div class="card border-0 shadow bg-gradient w-75 p-3">
        <div class="row">
            <div class="col-lg-7 py-2">
                <div class="divHead mb-4">
                    <h2 style="margin-bottom:25px !important">
                        <span class="border-bottom border-primary border-4">For</span>got Your Password?
                    </h2>
                    <div>
                        <form class="mt-2" id="account" autocomplete="off" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                            <div class="row">

                                <div class="col-md-12">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.Email" class="form-control border-1 shadow-sm" placeholder="Email" />
                                        <label class="text-muted" asp-for="Input.Email">Email Address</label>
                                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                                    </div>
                                </div>


                            </div>

                            <div class="row mt-3">
                                <div class="col-lg-12">
                                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Reset Password</button>
                                </div>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
            <div class="col-lg-5">
                <img src="~/images/register.png" alt="Register" class="img-fluid" style="height:100% !important" />
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="container d-flex justify-content-center align-items-center mt-3">
    <div class="card border-0 shadow w-75 p-3">
        <div class="row">
            <div class="col-lg-12 justify-content-center align-items-center">
                <h3 class="text-center">@ViewData["Title"]</h3>
            </div>
            <div class="col-lg-12 d-flex flex-column g-3 justify-content-center align-items-center">
                <img style="width:200px;height:200px" src="https://cdn.dribbble.com/userupload/21239475/file/original-a3366d7d574af7bd159d38aecc022905.gif" />
                <p>
                    Please check your email to reset your password.
                </p>
            </div>
        </div>
    </div>
</div>



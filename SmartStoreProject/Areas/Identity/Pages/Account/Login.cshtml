@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}
<style>
    input {
        height: 45px !important;
    }

    label {
        padding: 10px 10px !important;
    }
</style>


<div class="container mt-4 d-flex justify-content-center align-items-center">
    <div class="card border-0 shadow bg-gradient w-75 p-3">
        <div class="row">
            <div class="col-lg-7 py-2">
                <div class="divHead mb-4">
                    <h2 style="margin-bottom:25px !important">
                        <span class="border-bottom border-primary border-4">Wel</span>come Back
                    </h2>
                    <div >
                        <form class="mt-2" id="account" autocomplete="off" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                            <div class="row">

                                <div class="col-md-12">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.Email" class="form-control border-0 shadow-sm" placeholder="Email" />
                                        <label class="text-muted" asp-for="Input.Email">Email Address</label>
                                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- Password -->
                                <div class="col-md-12">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.Password" type="password" class="form-control border-0 shadow-sm" placeholder="Password" />
                                        <label class="text-muted" asp-for="Input.Password">Password</label>
                                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="d-flex flex-row justify-content-between">
                                        <div>
                                            <label asp-for="Input.RememberMe">
                                                <input class="form-check-input" style="height: 1em !important;margin-right:5px !important" asp-for="Input.RememberMe" />
                                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                                            </label>
                                        </div>
                                        <div style="align-self:center">
                                            <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
                                        </div>
                                    </div>

                                </div>
                               
                            </div>

                            <div class="row mt-3">
                                <div class="col-lg-12">
                                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>
                                </div>
                            </div>
                        </form>
                    </div>
                    
                </div>
            </div>
            <div class="col-lg-5">
                <img src="~/images/register.png" alt="Register" class="img-fluid" style="height:100% !important" />
            </div>
        </div>
    </div>
  
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

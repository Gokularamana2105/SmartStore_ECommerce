
<div class="container mt-3 mb-3 d-flex justify-content-center">
    <div class="card text-center d-flex justify-content-center flex-column align-items-center w-5 p-5 shadow">
       
        <h6 class="text-center">
          <img src="~/images/bannerimage/TickImage.jpg" style="width:150px;height:150px" />
        </h6>
        <h6 style="color:#005bab">Thank You For Your Order</h6>
        <p class="text-center">We've received your order and are preparing it for shipment</p>
        <h6>
            <img src="~/images/bannerimage/E-commerimage.jpg" style="width:300px;height:300px;border-radius:5px" />
        </h6>
        <h4 class="text-center fw-bold">Your Order is Confirmed</h4>
        <p class="p-2 text-center fw-bold" style="background-color:whitesmoke;border-radius:5px;color:#005bab">Order Number: #(@ViewBag.OrderNumber)</p>
        <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-primary "><i class="bi bi-house-fill"></i> Back To Home</a>
    </div>
</div>

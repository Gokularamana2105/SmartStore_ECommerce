@model SummaryDetailsVM



<div class="container d-flex justify-content-center align-items-center mt-2 mb-3">
    <div class="card border-0 shadow bg-gradient w-75">
        <div class="row border-top border-1">
            <div class="col-lg-12">
                <h4 class="text-white p-3 border-top rounded-1" style="background-color:#000080 !important">Complete Your Order</h4>
            </div>
        </div>
        <div class="row p-3">
            <div class="col-md-6">
                <h6 class="text-primary fw-bold">Billing Information</h6>
                <div class="row mt-3">
                    <div class="col-md-12 mb-3">
                        <label for="txtName" class="form-label">Full Name</label>
                        <input type="text" id="txtName" class="form-control shadow" disabled value="@Model.users.Name" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="txtCity" class="form-label">City</label>
                        <input type="text" id="txtCity" class="form-control shadow" disabled value="@Model.users.City" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="txtPhone" class="form-label">Phone Number</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-telephone-fill"></i>
                            </span>
                            <input type="text" id="txtPhone"
                            class="form-control shadow"
                            value="@Model.users.PhoneNumber"
                            readonly />
                        </div>
                    </div>
                    <div class="col-md-12 mb-3">
                        <label for="txtStreet" class="form-label">Street</label>
                        <input type="text" id="txtStreet" class="form-control shadow" disabled value="@Model.users.Street" />

                    </div>
                </div>

                <div class="divOrder">
                   

                </div>
            </div>
            
            <div class="col-md-6">
                <h6 class="text-primary fw-bold">Order Summary</h6>
                <div class="row mt-3">
                    <div class="col-md-12">
                        <div class="d-flex justify-content-between">
                            <label class="form-label">Your Items</label>
                            <a asp-controller="Cart" asp-action="Index" class="btn btn-primary">
                                Edit Cart
                            </a>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-lg-12 col-md-12">
                            <div class="card border-0 shadow p-3" style="height:175px !important;overflow-y:auto !important;scrollbar-width:thin !important">
                                @{
                                    int index = 0;
                                    int total = Model.summary.Count;
                                }
                                @foreach (var items in Model.summary)
                                {
                                    bool isLast = (index == total - 1);
                                    <div class="d-flex justify-content-between align-items-center mb-3 p-2 @(isLast ? "" : "border-bottom")">
                                        <div class="d-flex flex-row align-items-center">
                                            <div class="position-relative me-3">
                                                <img src="@items?.ProductImage" class="rounded" style="width:50px;height:50px;object-fit:cover;" />
                                                <span class="badge rounded-pill bg-primary position-absolute top-0 start-100 translate-middle">
                                                    @items?.count
                                                </span>
                                            </div>
                                            <div class="d-flex flex-column">
                                                <label class="fw-bold mb-1">@items?.ProductName</label>
                                                <small class="text-muted">@items?.Price.ToString("C") each</small>
                                            </div>
                                        </div>

                                        <div class="fw-bold text-dark">
                                            @items?.Total.ToString("C")
                                        </div>
                                    </div>
                                    index++;
                                }
                            </div>
                        </div>
                       
                        
                    </div>
                    <div class="row border-bottom border-1 py-2 mb-0">
                        <div class="col-md-12 mt-3 mb-1">
                            <div class="d-flex justify-content-between">
                                <p class="text-muted">SubTotal</p>
                                <p class="text-muted">
                                    @Model.summary.GroupBy(x => x.ProductName).Sum(g => g.Sum(i => i.Total)).ToString("c2")
                                </p>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="d-flex justify-content-between">
                                <p class="text-muted">Shipping</p>
                                <p class="text-muted">Free</p>
                            </div>
                        </div>

                       
                    </div>
                    <div class="row">
                        <div class="col-md-12 mb-3 mt-2">
                            <div class="d-flex justify-content-between">
                                <p class="text-muted fw-bold">Total</p>
                                <p class="text-primary fw-bold">
                                    @Model.summary.GroupBy(x => x.ProductName).Sum(g => g.Sum(i => i.Total)).ToString("c2")
                                </p>
                            </div>
                        </div>
                        <div class="col-md-12 mb-2">
                            <a id="checkoutbutton" data-userid="@Model.orders.UserId"
                            data-name="@Model.orders.UserName"
                            data-city="@Model.orders.City"
                            data-phone="@Model.orders.PhoneNumber"
                            data-ordernumber="@Model.orders.OrderNumber"
                            data-status="@Model.orders.Status"
                            data-id="@Model.orders.Id"
                            class="btn btn-primary form-control checkoutbtn">
                                <i class="bi bi-cart-check me-2"></i> Place Order
                            </a>
                        </div>
                        <div class="col-md-12">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary form-control">
                                <i class="bi bi-arrow-left me-2"></i> Continue Shopping
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const stripe = Stripe("@ViewBag.PublicKey");
           const summaryJson = '@Html.Raw(JsonConvert.SerializeObject(Model.summary).Replace("\\", "\\\\").Replace("'", "\\'"))';
             const summaryData = JSON.parse(summaryJson); 
            document.querySelectorAll('.checkoutbtn').forEach(btn => {
                btn.addEventListener("click", function (event) {
                    event.preventDefault();

                    const responses = {
                        UserId: this.dataset.userid,
                        UserName: this.dataset.name,
                        City: this.dataset.city,
                        Phone: this.dataset.phone,
                        OrderNumber: this.dataset.ordernumber,
                        Status: this.dataset.status,
                        Id: this.dataset.id,
                        Summary: summaryData
                    };

                    fetch("/Customer/CheckOut/CreateCheckOutSession", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(responses)
                    })
                    .then(res => res.json())
                    .then(session => {
                        window.location = session.url;
                    });
                });
            });
        });
    </script>

}
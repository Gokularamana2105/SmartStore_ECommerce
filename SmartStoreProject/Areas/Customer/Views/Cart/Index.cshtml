@model List<Cart>

@{
    var manageRoles = new[] { Roles.Admin, Roles.Editor };
    bool isTrue = manageRoles.Any(role => User.IsInRole(role));
}

<style>
    #btnContinue:hover{
    background-color:white !important;
    color:black !important;
    }
    #btnMinus:focus{
    box-shadow:none !important;
    }

    #btnPlus:focus {
    box-shadow: none !important;
    }
</style>

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-12 d-flex flex-row justify-content-center">
            <div class="card border-0 border rounded bg-gradient shadow w-75">
                <div class="card-header text-light" style="background-color:#000080 !important">
                    <div class="d-flex flex-row justify-content-between">
                        <div class="divShopping">
                            <i class="bi bi-cart-fill"></i> Shopping Cart
                        </div>
                        @if(!isTrue){
                            <div>
                                <a asp-area="Customer" asp-controller="Home" asp-action="Index" id="btnContinue" class="badge bg-gradient border-1 border border-white border-collapse rounded-pill text-light" style="text-decoration: none;cursor:pointer">
                                    Continue Shopping
                                </a>
                            </div>
                        }
                        else{
                            <div>
                                <a asp-area="Customer" asp-controller="Home" asp-action="Index" id="btnContinue" class="badge bg-gradient border-1 border border-white border-collapse rounded-pill text-light" style="text-decoration: none;cursor:pointer">
                                    Back To List
                                </a>
                            </div>
                        }
                    </div>
                </div>
                <div class="card-body p-3" style="height:250px !important;overflow-y:auto !important;scrollbar-width:thin !important">
                    <div class="row">
                        @if(Model.Count()==0){
                            <div class="col-lg-12">

                                <div class="d-flex flex-column justify-content-center align-items-center" style="height:150px;">

                                    <i class="bi bi-basket" style="font-size: 70px; color: #333;"></i>
                                    <h4 class="mt-3">Your Cart is Empty</h4>
                                    <p class="text-muted">Add some items to get started</p>
                                </div>
                            </div>
                        }

                    </div>
                    <div class="row">
                        @{
                            int index = 0;
                            int total = Model.Count;
                        }
                        @foreach(var items in Model)
                        {
                            bool isLast = (index == total - 1);

                            <div class="col-lg-12 cardItem">
                                <div class="d-flex flex-row justify-content-between align-items-center py-3 @(isLast ? "" : "border-bottom")">
                                    <div class="d-flex flex-row gap-3">
                                        <input type="hidden" class="ProductId" id="ProductId" data-id="@items.Id" value="@items.Id" />
                                        <img src="@items.ProductImage" id="prdtImage" class="rounded prdtImage" style="height:60px;width:60px;object-fit:fill" />

                                        <div class="d-flex flex-column justify-content-center" style="min-width:200px;">
                                            <h6 class="fw-bold mb-1 prdtName" id="prdtName">@items.Name</h6>
                                            <small class="text-muted">@items.Description</small>
                                        </div>
                                    </div>
                                    <div class="d-flex flex-row align-items-center gap-4" style="min-width:200px;justify-content:end;">
                                        <div class="d-flex flex-row align-items-center gap-2" style="min-width:300px;justify-content:end;">
                                            <h6 class="text-primary mb-0" >@items.Price.ToString("c2")</h6>
                                            <input type="hidden" class="prdtPrice" id="prdtPrice" data-price="@items.Price" />
                                            <span class="fw-light" style="align-self:center">x</span>
                                            <h6 class="mb-0 txtCount" id="prdtCount">@items.count</h6>

                                        </div>
                                        @if(!isTrue){
                                            <div class="d-flex flex-row border rounded border-primary">
                                                <button id="btnPlus" onclick="plus(this)" class="btn btn-sm btn-light text-primary">+</button>
                                                <div class="border-end d-flex align-items-center border-primary"></div>
                                                <button id="btnMinus" onclick="minus(this)" class="btn btn-sm btn-light text-primary">−</button>
                                            </div>
                                        }
                                    

                                    </div>
                                    @if(!isTrue){
                                        <div>

                                            <a onclick="deleteProduct(this)" data-id="@items.Id" class="btn btn-sm rounded-circle" style="background-color:#fbecec;color:#e63946;">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    }
                                    else{
                                        <div>
                                        </div>
                                    }

                                </div>
                            </div>
                            index++;

                        }

                        <div class="col-lg-12 p-3 d-flex justify-content-end" >
                            <div class="d-flex flex-column gap-2 p-3 rounded " style="background-color:whitesmoke !important ;@(Model.Count()==0?"display:none !important":"display:flex !important")">
                                <div class="d-flex flex-row gap-5 justify-content-between">
                                    <p class="fw-bold">Total(Rupees)</p>
                                    <p class="fw-bold">@Model.Sum(x => x.TotalAmout).ToString("c2")</p>
                                </div>
                                 @if(!isTrue){
                                    <div>
                                        <a onclick="saveSummary()" class="btn btn-primary rounded-pill form-control">
                                            Proceed to Checkout
                                        </a>
                                    </div>
                                 }
                                 else{
                                     <div>
                                     </div>
                                 }
                               
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
 
</div>

@section Scripts{
    <script type="text/javascript">
        function plus(button){
            debugger;
            let row = button.closest(".d-flex.flex-row.align-items-center");
            var count=row.querySelector('.txtCount');
            let current=parseInt(count.innerText);
            if(current<10){
                current=current+1;
                count.innerText=current;
            }
            var id=row.closest('.col-lg-12').querySelector('#ProductId').value;
            var price=row.closest('.d-flex.flex-row.align-items-center').querySelector('.prdtPrice').getAttribute('data-price');
            $.ajax({
                type:"POST",
                url:"/Customer/Cart/Increase_DecreaseCount",
                data:{id:id,count:current,price:price},
                success:function(r){
                    if(r.success){
                        location.reload();
                    }
                },
                error:function(xhr){
                      console.error("Error updating:", xhr);
                }
            });

        }

         function minus(button){
            let row = button.closest(".d-flex.flex-row.align-items-center");
            var count=row.querySelector('.txtCount');
             let current=parseInt(count.innerText);
            if(current>1){
                current=current-1;
                count.innerText=current;
            }

            var id=row.closest('.col-lg-12').querySelector('#ProductId').value;
            var price=row.closest('.d-flex.flex-row.align-items-center').querySelector('.prdtPrice').getAttribute('data-price');
            $.ajax({
                type:"POST",
                url:"/Customer/Cart/Increase_DecreaseCount",
                data:{id:id,count:current,price:price},
                success:function(r){
                    if(r.success){
                          location.reload();
                    }
                },
                error:function(xhr){
                      console.error("Error updating:", xhr);
                }
            });
        }

        function deleteProduct(button)
        {
            debugger;
            var id=button.getAttribute("data-id");
             Swal.fire({
                      title: "Are you sure?",
                      text: "You won't be able to revert this!",
                      icon: "warning",
                      showCancelButton: true,
                      confirmButtonColor: "#3085d6",
                      cancelButtonColor: "#d33",
                      confirmButtonText: "Yes, delete it!"
             })
            .then((result) =>
            {
                if (result.isConfirmed)
                {
                    $.ajax({
                        type:"POST",
                        url:"/Customer/Cart/Delete/"+id,
                        contentType: 'application/json',
                        success:function(res)
                        {
                            if(res.success)
                            {
                                var message=res.message;
                                if(message){
                                      toastr.options = {
                                        closeButton: true,
                                        progressBar: true,
                                        positionClass: "toast-top-right",
                                        timeOut: 3000
                                    };
                                    toastr.error(message);
                                }
                                setTimeout(function(){
                                       location.reload();
                                },3000);
                            }
                            else
                            {
                                alert("Error on Deleting");
                            }
                        }
                    })
                }
            });
        }
        function saveSummary(){
            debugger;
            var formData=new FormData();
            var productData=[];
            $('.cardItem').each(function(){
                var product={};
                product.ProductName=$(this).find('.prdtName').text();
                product.Price=$(this).find('.prdtPrice').data('price');
                product.count=$(this).find('.txtCount').text();
                product.CartId=$(this).find('.ProductId').data('id');
                 var img=$(this).find(".prdtImage").attr("src");
                 var fileName=img.split('\\').pop().split('/').pop();
                 var imgName=fileName.split('_').pop();
                 product.FormImage=imgName;

                 productData.push(product);
            })
            formData.append("summaries",JSON.stringify(productData));
 
            $.ajax({
                type:"POST",
                url:"/Customer/Cart/InsertSummary",
                data:formData,
                contentType:false,
                processData:false,
                success:function(a){
                    if(a.success){
                        window.location.href=a.redirectUrl;
                    }
                },
                error:function(a){
                     toastr.options = {
                                closeButton: true,
                                progressBar: true,
                                positionClass: "toast-top-right",
                                timeOut: 3000
                            };
                    toastr.error(a.message);
                }
            })
            
        }

    </script>
}


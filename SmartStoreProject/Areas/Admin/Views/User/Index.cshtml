@model List<ApplicationUser>


<div class="container-fluid">
<div class="row">
    <div class="col-md-12">
        <h3>Users Management</h3>
    </div>
</div>
<div class="row mt-3">
    <div class="col-lg-12">
        <div class="card border-0 shadow bg-gradient p-4">
            <div class="row">
                <div class="col-lg-12">
                    <h5 class="border-1 border-bottom py-2" style="border-color:darkgray">View Users</h5>
                </div>
            </div>
            <div class="row mt-2 mb-3">
                <div class="col-lg-12 d-flex justify-content-end">
                        <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Register">Create User</a>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12">
                    <table id="tblUsers" class="table table-responsive-md table-striped mb-3">
                        <thead>
                            <tr>
                                <th class="text-center">
                                    Name
                                </th>
                                <th class="text-center">
                                    Email
                                </th>
                                <th class="text-center">
                                   Phone Number
                                </th>
                                <th class="text-center">
                                    Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var items in Model)
                            {
                                <tr>
                                    <td>
                                        @items.Name
                                    </td>
                                    <td>
                                        @items.Email
                                    </td>
                                    <td>
                                       @items.PhoneNumber

                                    </td>
                                    <td>
                                        <div class="btn-group w-100" role="group">
                                                <a id="lockToggleBtn" onclick="toggleLock(this)" data-id="@items.Id" class="btn @(items.isActive==true?"btn-success":"btn-danger")" style="margin-right:10px" data-bs-toggle="tooltip"
                                               data-bs-placement="top"
                                                   title="Edit">
                                                    <i class="bi @(items.isActive==true?"bi-unlock-fill":"bi-lock-fill")" ></i>
                                            </a>
                                            <a onclick="deleteUser('@items.Id')" class="btn btn-danger" data-bs-toggle="tooltip"
                                               data-bs-placement="top"
                                               title="Delete">
                                                <i class="bi bi-trash3-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

</div>

@section Scripts{
    <script>
        $(document).ready(function(){
             $('#tblUsers').DataTable(
                 {
                  
                   "lengthMenu": [5, 10, 15, 20,50,100],
                 }
             );
        });

        function deleteUser(Id){
            debugger;
                Swal.fire({
                    title: "Are you sure?",
                    text: "You won't be able to revert this!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    confirmButtonText: "Yes, delete it!"
                }).then((result)=>
                {
                    if(result.isConfirmed){
                        $.ajax({
                            type:"POST",
                            url:"/Admin/User/Delete/"+Id,
                             contentType: 'application/json',
                             success:function(res)
                              {
                                  if(res.success)
                                  {
                                       toastr.options = {
                                            closeButton: true,
                                            progressBar: true,
                                            positionClass: "toast-top-right",
                                            timeOut: 2000
                                       };
                                      toastr.error(res.message);
                                      setTimeout(function ()
                                        {
                                            location.reload();
                                        }, 2000
                                      );

                                      
                                  }
                                  else
                                  {
                                      alert("Error: " + res.message);
                                  }
                              }
                        })
                    }
                });
        }
        function toggleLock(button) {
            debugger;
            const icon = button.querySelector('i');

            const isUnlocked = icon.classList.contains('bi-unlock-fill');
            var Id=button.getAttribute('data-id');

            if (isUnlocked) {
                icon.classList.remove('bi-unlock-fill');
                icon.classList.add('bi-lock-fill');
                button.classList.add('btn-danger');
                button.classList.remove('btn-success');
                button.setAttribute('title', 'Locked');
                 $.ajax({
                    type:"POST",
                    url:"/Admin/User/RemoveUser/"+Id,
                        contentType: 'application/json',
                        success:function(res)
                        {
                            if(res.success)
                            {
                            }
                            else
                            {
                                alert("Error: " + res.message);
                            }
                        }
                 });

            } else {
                icon.classList.remove('bi-lock-fill');
                icon.classList.add('bi-unlock-fill');
                button.classList.add('btn-success');
                button.classList.remove('btn-danger');
                button.setAttribute('title', 'Unlocked');
                  $.ajax({
                    type:"POST",
                    url:"/Admin/User/Include/"+Id,
                        contentType: 'application/json',
                        success:function(res)
                        {
                            if(res.success)
                            {
                            }
                            else
                            {
                                alert("Error: " + res.message);
                            }
                        }
                 });

            }


           
        }

    </script>
}
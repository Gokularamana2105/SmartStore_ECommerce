
@model List<Category>

<style>
    #tblCategory_filter{
        margin-bottom:20px;
    }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <h3>Category Management</h3>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-lg-12">
            <div class="card border-0 shadow bg-gradient p-4">
                    <div class="row">
                        <div class="col-lg-12">
                            <h5 class="border-1 border-bottom py-2" style="border-color:darkgray">View Categories</h5>
                        </div>
                    </div>
                    <div class="row mt-2 mb-3">
                        <div class="col-lg-12 d-flex justify-content-end">
                            <a onclick="createCategory()" class="btn btn-primary">Create</a>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12">
                            <table id="tblCategory" class="table table-responsive-md table-striped mb-3">
                                <thead>
                                    <tr>
                                        <th class="text-center">
                                            Name
                                        </th>
                                        <th class="text-center">
                                            Description
                                        </th>
                                        <th class="text-center">
                                            Date Created
                                        </th>
                                        <th class="text-center">
                                            Actions
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach(var items in Model.OrderBy(r=>r.DateCreatedOn.ToShortDateString())){
                                        <tr>
                                            <td>
                                                @items.Name
                                            </td>
                                            <td>
                                                @items.Description
                                            </td>
                                            <td>
                                                @(items.DateCreatedOn.ToString("MM/dd/yyyy", System.Globalization.CultureInfo.InvariantCulture))

                                            </td>
                                            <td>
                                                <div class="btn-group w-100" role="group">
                                                  <a onclick="editCategory('@items.Id')" class="btn btn-warning" style="margin-right:10px" data-bs-toggle="tooltip"
                                                       data-bs-placement="top"
                                                       title="Edit"><i class="bi bi-pencil-fill"></i></a>
                                                <a onclick="deleteCategory('@items.Id')" class="btn btn-danger" data-bs-toggle="tooltip"
                                                       data-bs-placement="top"
                                                       title="Delete">
                                                        <i class="bi bi-trash3-fill"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                   
                                </tbody>
                            </table>
                        </div>
                    </div>
               
            </div>
        </div>
    </div>
   
</div>

<div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="categoryModalLabel">New Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="Id" />
                <input type="hidden" id="EmptyId" value="@Guid.Empty" />

                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <input id="Name" class="form-control" oninput="allowOnlyCharsAndSpace(this)" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea class="form-control" oninput="allowOnlyCharsAndSpace(this)" id="Description"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnSave" class="btn btn-success" onclick="saveCategory()">Save</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(document).ready(function(){
            $('#tblCategory').DataTable(
                {
                   "lengthMenu": [5, 10, 15, 20,50,100],
                   "order": [[2, "asc"]]
                }
            );
        });

        function allowOnlyCharsAndSpace(input) {
            input.value = input.value.replace(/[^a-zA-Z\s]/g, '');
        }

        function createCategory(){
            $('#Id').val('');
            $('#Name').val('');
            $('#Description').val('');
            $('#categoryModal').modal('show');
            $('#categoryModalLabel').text('New Category');
            $('#btnSave').text('Save');
            $('#btnSave').addClass('btn-success').removeClass('btn-danger');
        }

        function editCategory(id){
            $.get("/Admin/Category/GetCategory/"+id,function(data) {

                  $('#Id').val(data.id);
                  $('#Name').val(data.name);
                  $('#Description').val(data.description);
                  $('#categoryModal').modal('show');
                  $('#categoryModalLabel').text('Update Category');
            });
        }

         function deleteCategory(id){
            $.get("/Admin/Category/GetCategory/"+id,function(data) {

                  $('#Id').val(data.id);
                  $('#Name').val(data.name).prop("readonly",true);
                  $('#Description').val(data.description).prop("readonly",true);
                  $('#categoryModal').modal('show');
                  $('#btnSave').text('Delete');
                  $('#btnSave').addClass('btn-danger').removeClass('btn-success');
                  $('#categoryModalLabel').text('Delete Category');
            });
        }

        function saveCategory()
        {

            var name=$('#Name').val();
            var description=$('#Description').val();
            var errmsg='';
            var errcount=0;
            var firstObj=null;
            if(name==''){
                errmsg +=++errcount +". Name is required.\n";
                if(firstObj==null){
                    firstObj=$('#Name');
                }
            }
             if(description==''){
                errmsg +=++errcount +". Description is required.\n";
                if(firstObj==null){
                    firstObj=$('#Description');
                }
            }

            if(errcount>0){
               alert(errmsg);
                if(firstObj!=null){
                    firstObj.focus();
                }
                return false;

            }
            return true;
            var btnValue= $('#btnSave').text();
            var idVal=$('#Id').val();
            var emptyId=$('#EmptyId').val();
            const data={
                Id:idVal.trim()!=""?idVal:emptyId,
                Name:$('#Name').val(),
                Description:$('#Description').val()
            }
            if(btnValue=="Save")
            {
                $.ajax({
                    type:"POST",
                    url:"/Admin/Category/Upsert",
                    contentType: 'application/json',
                    data:JSON.stringify(data),
                    success:function(res)
                    {
                        if(res.success){
                            alert(res.message);
                            location.reload();
                        }
                        else{
                             alert("Error: " + res.message);
                        }
                    }
                })
            };

            if(btnValue=="Delete")
            {
                Swal.fire({
                    title: "Are you sure?",
                    text: "You won't be able to revert this!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    confirmButtonText: "Yes, delete it!"
                }).then((result) => 
                {
                    if (result.isConfirmed) 
                    {
                          $.ajax({
                              type:"POST",
                              url:"/Admin/Category/DeletePost/"+idVal,
                              contentType: 'application/json',
                              success:function(res)
                              {
                                  if(res.success)
                                  {
                                      alert(res.message);
                                      location.reload();
                                  }
                                  else
                                  {
                                      alert("Error: " + res.message);
                                  }
                              }
                          })
                    }
                });
            }
            
        }
    </script>
}
@model OrderDetailVM

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12">
            <h3>Orders Management</h3>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-lg-12">
            <div class="card border-0 shadow p-4">
                <div class="row">
                    <div class="col-lg-12">
                        <h5 class="border-1 border-bottom py-2" style="border-color:darkgray">View Order Details</h5>
                    </div>
                </div>
                <div class="row mt-3 d-flex justify-content-center">
                    <div class="col-lg-12" style="width:80% !important">
                        <div class="row mt-3 " style="gap:60px">
                            <div class="col-lg-6">
                                <h6>PickUp Details</h6>
                                <input type="hidden" id="hdnOrderId" value="@Model.order.Id" />
                                <div class="form-group d-flex gap-3 mt-4 mb-0">
                                    <label class="w-50" style="align-self:center">Name </label>
                                    <input class="form-control" disabled value="@Model.order.UserName"/>
                                </div>
                                <div class="form-group d-flex gap-3 mt-2">
                                    <label class="w-50" style="align-self:center">Phone </label>
                                    <input class="form-control" disabled value="@Model.order.PhoneNumber" />
                                </div>
                                <div class="form-group d-flex gap-3 mt-2">
                                    <label class="w-50" style="align-self:center">City </label>
                                    <input class="form-control" disabled value="@Model.order.City" />
                                </div>
                                <div class="form-group d-flex gap-3 mt-2">
                                    <label class="w-50" style="align-self:center">Order Number  </label>
                                    <input class="form-control" disabled value="@Model.order.OrderNumber" />
                                </div>
                                <div class="form-group d-flex gap-3 mt-2">
                                    <label class="w-50" style="align-self:center">Order Date  </label>
                                    <input class="form-control" disabled value="@Model.order.OrderedDate.ToShortDateString()" />
                                </div>
                                <div class="form-group d-flex gap-3 mt-2">
                                    <label class="w-50" style="align-self:center">Shipping Date  </label>
                                    <input class="form-control" disabled value="@Model.order.ShippingDate.ToShortDateString()" />
                                </div>
                                <div class="form-group d-flex gap-3 mt-2">
                                    <label class="w-50" style="align-self:center">Payment Status  </label>
                                    <input class="form-control" disabled value="@Model.order.Status" />

                                </div>
                                <div class="form-group d-flex gap-3 mt-2">
                                    <label class="w-50" style="align-self:center">Total Prize  </label>
                                    <input class="form-control" disabled value="@Model.order.Total" />

                                </div>
                            </div>
                            <div class="col-lg-5">
                                <h6>Order Summary</h6>
                                @if(Model.order.Status!="Approved"){
                                    <div class="btn form-control" style="background:#cce5ff;color:#007bff;">Order Status- Pending</div>
                                }
                                else
                                {
                                    <div class="btn form-control" style="background:#cce5ff;color:#007bff;">
                                        Order Status- Approved
                                    </div>
                                }
                                <div class="card mt-2">
                                    @{
                                        var index = 0;
                                        var total = Model.summary.Count();

                                    }
                                    @foreach(var items in Model.summary){
                                        bool isLast = (index == total - 1);
                                        <div class="d-flex flex-row justify-content-between p-3 m-2 mb-1 @(isLast ? "" : "border-bottom")">
                                            <div class="d-flex flex-column g-0 mb-0">
                                                <p class="fw-normal mb-0" style="color:#007bff;">@items.ProductName</p>
                                                <span>Price    : @items.Price</span>
                                                <span>Quantity : @items.count</span>
                                            </div>
                                            <div class="divPrice">
                                                <p class="fw-normal text-success">@items.Price.ToString("c2")</p>
                                            </div>
                                        </div>
                                        index++;
                                    }
                                   
                                </div>
                                <div class="mt-2">
                                    <div class="bg-dark p-3 text-center text-white d-flex flex-row justify-content-between">
                                        <h6>Total</h6>
                                        <h6>@Model.order.Total.ToString("c2")</h6>
                                    </div>
                                    <div class="d-flex  mt-2 flex-row justify-content-between">
                                        @if (Model.order.Status != "Approved")
                                        {
                                            <button onclick="removeOrder()"  class="btn btn-danger">Cancel Order</button>
                                        }
                                        <a class="btn btn-primary" asp-controller="Order" asp-action="Index">Back To List</a>
                                    </div>
                                   

                                </div>
                            </div>
                       </div>
                   </div>
                </div>
            </div>
        </div>
    </div>
   
</div>

@section Scripts{
    <script>
        function removeOrder(){
            var Id=$('#hdnOrderId').val();
             Swal.fire({
                      title: "Are you sure?",
                      text: "You want to cancel this order!",
                      icon: "warning",
                      showCancelButton: true,
                      confirmButtonColor: "#3085d6",
                      cancelButtonColor: "#d33",
                      confirmButtonText: "Yes, Cancel it!"
              })
             .then((result) =>
             {
                if (result.isConfirmed)
                {
                    $.ajax({
                        type:"POST",
                        url:"/Admin/Order/Delete/"+Id,
                        contentType: 'application/json',
                        success:function(res)
                        {
                            if(res.success)
                            {
                                toastr.options = {
                                    closeButton: true,
                                    progressBar: true,
                                    positionClass: "toast-top-right",
                                    timeOut: 3000
                                };
                                toastr.error(res.message);
                                     
                            setTimeout(function(){
                                window.location.href=res.redirectUrl;
                            },3000);
                        }
                            else
                            {
                                alert("Error: " + res.message);
                            }
                        }
                    })
                }
             });
        }
    </script>
  
}

<!DOCTYPE html>

@{
    var manageRole = new[] { Roles.Admin, Roles.Editor };
    bool isTrue = manageRole.Any(role => User.IsInRole(role));

}

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartStoreProject</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartStoreProject.styles.css" asp-append-version="true" />
    <link href="~/css/project.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />

</head>
<body>
    <header>
        <div class="d-flex flex-column">
            <nav class="navbar navbar-expand-lg navbar-dark bg-white border-bottom box-shadow mb-3">
                <div class="container">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-shop" style="color:#007BFF !important;"></i> SMART <span class="navHeadLabel">STORE</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                            aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNavbar">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Customer" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door"></i> Home
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Customer" asp-controller="Home" asp-action="About">
                                    <i class="bi bi-info-circle"></i> About
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Customer" asp-controller="Home" asp-action="Contact">
                                    <i class="bi bi-headset"></i> Contact
                                </a>
                            </li>
                            @if (isTrue)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2"></i> Dashboard
                                    </a>
                                </li>
                            }
                        </ul>
                        <partial name="_LoginPartial"></partial>
                        <div class="ms-lg-3 mt-2 mt-lg-0">
                            <a asp-area="Customer" asp-controller="Cart" asp-action="Index"
                               class="btn btn-info border-0 rounded-pill text-light"
                               style="background-color:blue;font-size:14px;">
                                <i class="bi bi-cart-fill"></i> Cart
                                <span id="cartCount" class="badge bg-dark rounded-pill" style="font-size:9px;">0</span>
                            </a>
                        </div>
                    </div>
                </div>
            </nav>



        </div>
       
    </header>

    <main id="divRenderbody" class="mb-5">
        @RenderBody()
    </main>
    <footer class="bg-dark text-light mt-3 pt-5 pb-3" style="background-color:#000080 !important">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-3 mb-4">
                    <h5 class="fw-bold text-uppercase">
                        <i class="bi bi-shop"></i> SMART <span class="text-primary">STORE</span>
                    </h5>
                    <p class="small">
                        Your premier destination for cutting-edge electronics and tech gadgets.
                        We deliver quality products with exceptional customer service.
                    </p>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-light"><i class="bi bi-facebook fs-5"></i></a>
                        <a href="#" class="text-light"><i class="bi bi-twitter-x fs-5"></i></a>
                        <a href="#" class="text-light"><i class="bi bi-instagram fs-5"></i></a>
                        <a href="#" class="text-light"><i class="bi bi-linkedin fs-5"></i></a>
                    </div>
                </div>

                <!-- Quick Links -->
                <div class="col-md-2 mb-4">
                    <h6 class="fw-bold">Quick Links</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-area="Customer" asp-controller="Home" asp-action="Index" class="text-light text-decoration-none">Home</a></li>
                        <li><a asp-area="Customer" asp-controller="Home" asp-action="Index" class="text-light text-decoration-none">Products</a></li>
                        <li><a asp-area="Customer" asp-controller="Home" asp-action="About" class="text-light text-decoration-none">About Us</a></li>
                        <li><a href="#" class="text-light text-decoration-none">Contact</a></li>
                        <li><a href="#" class="text-light text-decoration-none">FAQs</a></li>
                    </ul>
                </div>

                <!-- Customer Service -->
                <div class="col-md-3 mb-4">
                    <h6 class="fw-bold">Customer Service</h6>
                    <ul class="list-unstyled small">
                        <li><a href="#" class="text-light text-decoration-none">Shipping Policy</a></li>
                        <li><a href="#" class="text-light text-decoration-none">Return Policy</a></li>
                        <li><a href="#" class="text-light text-decoration-none">Privacy Policy</a></li>
                        <li><a href="#" class="text-light text-decoration-none">Terms of Service</a></li>
                    </ul>
                </div>

                <!-- Newsletter -->
                <div class="col-md-4 mb-4">
                    <h6 class="fw-bold">Stay Updated</h6>
                    <p class="small">Subscribe to our newsletter for the latest products and deals.</p>
                    <form class="d-flex mb-3">
                        <input type="email" class="form-control me-2" placeholder="Enter your email">
                        <button class="btn btn-primary"><i class="bi bi-envelope-fill"></i></button>
                    </form>
                    <ul class="list-unstyled small">
                        <li><i class="bi bi-geo-alt me-2"></i>125 Gandhi Street</li>
                        <li><i class="bi bi-telephone me-2"></i>+91-9838482345</li>
                        <li><i class="bi bi-envelope me-2"></i>info@smartstore.com</li>
                    </ul>
                </div>
            </div>

            <hr class="border-secondary">
            <div class="d-flex flex-column flex-md-row justify-content-center align-items-center">
                <p class="mb-0 small">© 2025 Smart Store. All rights reserved.</p>

            </div>
        </div>
    </footer>
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        <script type="text/javascript"></script>
        
        <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            $(document).ready(function(){
                $.get("/Customer/Home/CartCount", function(count){
                    $('#cartCount').text(count);
                });
            });
       </script>
    @await RenderSectionAsync("Scripts", required: false)

  
</body>
</html>
